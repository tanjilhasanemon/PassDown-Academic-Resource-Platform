# PassDown Backend Configuration Template (SRS NFR-04)
PROJECT_NAME="PassDown - Academic Resource-Sharing Platform"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./passdown_dev.db"
JWT_SECRET="replace-with-a-strong-256-bit-secret-in-production"
